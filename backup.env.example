# Supabase 백업 설정 — 이 파일을 복사해 backup.env 로 저장하고 값을 채우세요.
#  (backup.env 는 .gitignore 에 있어 git 에 안 올라갑니다 — 비밀값 넣어도 안전)

# 1) DB 접속문자열 — 대시보드 Connect > "Session pooler" 문자열. <password> 자리에 DB 비밀번호.
#    예: postgresql://postgres.uwbkejkztuhzcesrffzq:비밀번호@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_URL=

# 2) 프로젝트 URL (Storage 다운로드용)
SUPABASE_URL=https://uwbkejkztuhzcesrffzq.supabase.co

# 3) 서비스(secret) 키 — 대시보드 Settings > API 의 service_role/secret 키(sb_secret_... 로 시작). Storage 파일 다운로드에 필요.
SUPABASE_SERVICE_KEY=

# 4) 백업 저장 폴더 (OneDrive 동기화 폴더 권장). NAS·외장하드면 그 경로로 바꾸면 됩니다.
BACKUP_DIR=C:/Users/younh/OneDrive - 주식회사 씨몬스터/Supabase백업

# 5) (선택) 데이터에서 뺄 표 — 기본은 개인정보 표(고객 전화·이름). 콤마로 여러 개. 표 구조는 남고 행만 빠짐.
EXCLUDE_DATA=public.sales_customers

# 6) (선택) 덤프할 스키마 — 기본 public(+파도소리 factory). 문제 시 public 만 남기세요.
SCHEMAS=public,factory
