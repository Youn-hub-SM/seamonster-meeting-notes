# Supabase 백업 설정 — 이 파일을 복사해 backup.env 로 저장하고 값을 채우세요.
#  (backup.env 는 .env* 규칙으로 git 에 올라가지 않습니다 — 시크릿 키를 여기 넣어도 안전)

# 1) Supabase 프로젝트 URL (대시보드 Settings > API > Project URL)
SUPABASE_URL=https://uwbkejkztuhzcesrffzq.supabase.co

# 2) 서비스(secret) 키 — 대시보드 Settings > API > "service_role" 또는 "secret" 키(sb_secret_... 로 시작).
#    ※ 전 데이터를 읽어야 하므로 anon/publishable 이 아니라 secret 키가 필요합니다.
SUPABASE_SERVICE_KEY=

# 3) 백업을 저장할 폴더 (OneDrive 동기화 폴더 권장). 없으면 자동 생성됩니다.
BACKUP_DIR=C:/Users/younh/OneDrive - 주식회사 씨몬스터/Supabase백업

# 4) (선택) 백업에서 뺄 테이블 — 개인정보가 부담되면 여기에. 콤마로 여러 개.
#    예: sales_customers 는 고객 전화·이름(평문)이 들어 있습니다.
# SKIP_TABLES=sales_customers
